# Deny by default. Only inputs used by the application Dockerfile are allowed.
# Docker also needs this file and Dockerfile to process the build.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app/
!app/*.py
!app/demo_gatherings.json
!app/templates/
!app/templates/**/
!app/templates/**/*.html
!app/static/
!app/static/*.css
!app/static/*.js

# Defense in depth if the allowlist is expanded later.
**/.env
**/.env.*
**/*credentials*
**/*secret*
**/.aws
**/.ssh
**/.git
**/.git/**
**/.agents
**/.codex
**/backups
**/backups/**
**/*.db
**/*.db-*
**/*.sqlite*
**/*.sql
**/*.dump
**/*.bak
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/logs
**/logs/**
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/.venv
**/venv
**/node_modules
**/dist
**/build
**/.DS_Store
**/*.swp
**/*.tmp
**/*.tar*
**/*.zip
**/*.gguf
**/*.safetensors
